<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>HistoryParser</AssemblyName>
    <RootNamespace>HistoryParser.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- `dotnet publish -c Release` produces ONE self-contained HistoryParser.exe that runs on any
       Windows 10/11 x64 PC without installing .NET. Compression is the standard .NET single-file
       bundle compression (not obfuscation): ILSpy opens the bundle and shows readable code. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HistoryParser.Core\HistoryParser.Core.csproj" />
  </ItemGroup>
</Project>
