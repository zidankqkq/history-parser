<Window x:Class="HistoryParser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HistoryParser.App.ViewModels"
        xmlns:cv="clr-namespace:HistoryParser.App.Converters"
        xmlns:tamper="clr-namespace:HistoryParser.App.Tampering"
        Title="History Parser" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <cv:LocalTimeConverter x:Key="Time" />
        <cv:ToneBrushConverter x:Key="Tone" />
        <cv:EqualsToVisibilityConverter x:Key="PageVis" />
        <cv:EqualsToBoolConverter x:Key="Is" />
        <cv:VisibleWhenConverter x:Key="Vis" />
        <cv:StatusTextConverter x:Key="StatusText" />
        <cv:CategoryTextConverter x:Key="CategoryText" />

        <!-- Severity pill -->
        <DataTemplate x:Key="SeverityPill">
            <Border CornerRadius="{StaticResource RadiusS}" Padding="8,2" HorizontalAlignment="Left"
                    Background="{Binding Severity, Converter={StaticResource Tone}, ConverterParameter=soft}">
                <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{Binding Severity, Converter={StaticResource Tone}}" />
            </Border>
        </DataTemplate>

        <!-- Finding card (Overview, Findings, Inconsistencies) -->
        <DataTemplate x:Key="FindingCard">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusL}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="7,0,0,7" Background="{Binding Severity, Converter={StaticResource Tone}}" />
                    <StackPanel Grid.Column="1" Margin="14,11,14,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeUtc, Converter={StaticResource Time}}"
                                       Foreground="{StaticResource TextFaint}" FontSize="12" FontFamily="{StaticResource MonoFont}" />
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SeverityPill}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryText}}" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{StaticResource Text}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Margin="0,7,0,0" FontSize="12.5" />
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,7,0,0"
                                Visibility="{Binding Path, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Path}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Open this file's full record (greyed out when the file has no record, e.g. a driver or log path)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="Count" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Surface3}" />
        </Style>
        <Style x:Key="CountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSub}" />
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        </Style>
        <!-- A row that is a way in to a page: the whole row is the button. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="18,13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One choice in a list that drops down from a button. -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusS}" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The period in the title bar: it decides what every page lists, so it is the one tinted control on the line, and it
             says what it is ("Showing"). It was a grey box among grey text and went unnoticed. Opens the list of periods. -->
        <SolidColorBrush x:Key="PeriodEdge" Color="{StaticResource AccentColor}" Opacity="0.5" />
        <SolidColorBrush x:Key="PeriodHover" Color="#322C62" />
        <Style x:Key="PeriodToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource PeriodEdge}" BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="12" Margin="0,1,7,0" Foreground="{StaticResource AccentHover}" />
                                <TextBlock Text="Showing" FontWeight="Normal" Foreground="{StaticResource TextSub}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" Foreground="{StaticResource AccentHover}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PeriodHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <!-- While its list is open the button lets the click through, so clicking it again closes the list. -->
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Which build is running, at the end of the title bar: opens the whole hash. -->
        <Style x:Key="BuildToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="9,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <!-- While its card is open the button lets the click through, so clicking it again closes the card. -->
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A status pill that is also a button. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Medium}" />
            <Setter Property="Background" Value="{StaticResource MediumSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="8,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid Background="{StaticResource Surface}">
                <!-- The line on the left gives way to the build and the window buttons on the right when the window is narrow. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="History Parser" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="screenshare forensics" Foreground="{StaticResource TextFaint}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Visibility="{Binding HasResults, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <!-- Which PC, which period and when: on every page. The period is a control, because it decides what every page lists. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding PcName}" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding ScanLine}" />
                        <ToggleButton x:Name="PeriodToggle" Style="{StaticResource PeriodToggle}" Margin="10,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                                      Visibility="{Binding Periods.Count, Converter={StaticResource Vis}}"
                                      ToolTip="The period every page lists. The scan read and cross-checked everything; this only decides what is shown.">
                            <TextBlock Text="{Binding PeriodLabel}" />
                        </ToggleButton>
                        <TextBlock Text="{Binding PeriodLabel}" Foreground="{StaticResource TextSub}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Visibility="{Binding Periods.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <Popup x:Name="PeriodPopup" IsOpen="{Binding IsChecked, ElementName=PeriodToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=PeriodToggle}" Placement="Bottom">
                            <Border Style="{StaticResource PopupCard}" Width="340" Padding="8,10,8,8" ButtonBase.Click="Period_Click">
                                <StackPanel>
                                    <TextBlock Text="PERIOD SHOWN" Style="{StaticResource Caps}" Margin="10,2,0,8" />
                                    <ItemsControl x:Name="PeriodList" ItemsSource="{Binding Periods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MenuRow}" Command="{Binding DataContext.SetPeriodCommand, ElementName=PeriodList}" CommandParameter="{Binding Key}"
                                                        IsEnabled="{Binding Enabled}" ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Left" Width="22">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                                       Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}" />
                                                        </Grid>
                                                        <TextBlock DockPanel.Dock="Right" Text="scans again" FontSize="11.5" Foreground="{StaticResource Medium}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding Rescans, Converter={StaticResource Vis}}" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Start}" FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource MonoFont}" />
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <TextBlock Text="{Binding ScannedAt}" Foreground="{StaticResource TextSub}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        <!-- A narrower period never lets what is older go unseen: the files and the flagged findings it leaves out are counted here,
                             and it is the way back to the whole scan. Amber when a flagged finding is among them. -->
                        <Button Margin="12,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Content="{Binding EarlierText}"
                                Command="{Binding SetPeriodCommand}" CommandParameter="{Binding WholePeriodKey}" Visibility="{Binding EarlierText, Converter={StaticResource Vis}}"
                                ToolTip="What the scan holds from before the period shown: files with no activity since it began, and flagged findings dated earlier. Click to show the whole scan again.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FlaggedEarlier}" Value="0">
                                            <Setter Property="Background" Value="{StaticResource NeutralSoft}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSub}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- Before a scan only: once a result is on screen, the line above every page says what a scan without administrator rights left unread. -->
                    <Border Visibility="{Binding HasResults, Converter={StaticResource Vis}, ConverterParameter=invert}" VerticalAlignment="Center">
                        <Border Margin="14,0,0,0" CornerRadius="{StaticResource RadiusS}" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource HighSoft}"
                                Visibility="{Binding IsElevated, Converter={StaticResource Vis}, ConverterParameter=invert}">
                            <TextBlock Text="Not elevated" Foreground="{StaticResource High}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Border>
                    <Border Margin="10,0,0,0" CornerRadius="{StaticResource RadiusS}" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource LowSoft}"
                            Visibility="{Binding LoadedFrom, Converter={StaticResource Vis}}">
                        <TextBlock Foreground="{StaticResource Low}" FontSize="11" FontWeight="SemiBold">
                            <Run Text="Saved report:" /> <Run Text="{Binding LoadedFrom, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Margin="10,0,0,0" CornerRadius="{StaticResource RadiusS}" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource NeutralSoft}"
                            Visibility="{Binding AutoSaveStatus, Converter={StaticResource Vis}}" ToolTip="{Binding AutoSaveStatus}">
                        <TextBlock Text="{Binding AutoSaveStatus}" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="10,0,0,0" CornerRadius="{StaticResource RadiusS}" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource NeutralSoft}"
                            Visibility="{Binding ShowingRedactedReport, Converter={StaticResource Vis}}"
                            ToolTip="This report was saved with private details hidden: names are masked and personal history removed.">
                        <TextBlock Text="Private details hidden" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Which build is on screen, on every page: the version and the start of the SHA-256 of the file it was started from.
                         The card has the whole hash. It is the program's word about itself: a changed build can show any hash. -->
                    <ToggleButton x:Name="BuildToggle" Style="{StaticResource BuildToggle}" VerticalAlignment="Center" Margin="12,0,10,0"
                                  ToolTip="This program: its version and the start of its SHA-256. Click for the whole hash.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OwnHashShort}" FontFamily="{StaticResource MonoFont}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding OwnHashShort, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="BuildPopup" IsOpen="{Binding IsChecked, ElementName=BuildToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           PlacementTarget="{Binding ElementName=BuildToggle}" Placement="Custom">
                        <Border Style="{StaticResource PopupCard}" Width="408" ButtonBase.Click="Build_Click">
                            <StackPanel>
                                <TextBlock Text="THIS PROGRAM" Style="{StaticResource Caps}" />
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}" Foreground="{StaticResource TextSub}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OwnFileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding OwnFile}" Foreground="{StaticResource TextFaint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Text="SHA-256" Style="{StaticResource Caps}" Margin="0,14,0,6" />
                                <TextBlock Text="{Binding OwnHashLines}" FontFamily="{StaticResource MonoFont}" FontSize="14" LineHeight="23"
                                           Visibility="{Binding OwnHashLines, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding OwnHashNote}" Foreground="{StaticResource Medium}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding OwnHashNote, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Copy hash"
                                        Command="{Binding CopyCommand}" CommandParameter="{Binding OwnHash}" />
                                <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11.5" Margin="0,10,0,0" Text="Listed in the release's SHA256SUMS.txt." />
                                <StackPanel Visibility="{Binding ReportBuildText, Converter={StaticResource Vis}}">
                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,12" />
                                    <TextBlock Text="SAVED REPORT" Style="{StaticResource Caps}" />
                                    <TextBlock Text="{Binding ReportBuildText}" FontSize="13" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding ReportBuildLines}" FontFamily="{StaticResource MonoFont}" FontSize="13" LineHeight="21" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextSub}" Visibility="{Binding ReportBuildLines, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource CaptionButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= Sidebar ================= -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
                    <DockPanel Margin="12,12,12,14">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Margin="0,0,0,10"
                                         IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Help}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" />
                                    <TextBlock Style="{StaticResource NavLabel}" Text="Help" />
                                </DockPanel>
                            </RadioButton>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,12" />

                            <!-- Report: the three exports, and under them the one switch that changes what they contain. -->
                            <StackPanel Margin="0,0,0,14" Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
                                <TextBlock Text="REPORT" Style="{StaticResource Caps}" Margin="2,0,0,6" />
                                <UniformGrid Columns="3">
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding ExportHtmlCommand}" Margin="0,0,3,0" Padding="6,8"
                                            Content="HTML" ToolTip="Save a self-contained HTML report to share with staff" />
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding ExportJsonCommand}" Margin="3,0" Padding="6,8"
                                            Content="JSON" ToolTip="Save the full report; staff can reopen it in HistoryParser (Open saved report)" />
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding ExportCsvCommand}" Margin="3,0,0,0" Padding="6,8"
                                            Content="CSV" ToolTip="Save the table on this page, exactly as filtered and sorted" />
                                </UniformGrid>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HidePrivate}" Content="Hide private details" FontSize="12.5" Margin="2,10,0,0"
                                          ToolTip="Exports mask the PC and user names, drop unflagged command history, typed searches and raw memory text. Files, findings and flagged commands are kept." />
                            </StackPanel>

                            <!-- Scan: where the results on screen come from - a new scan, or a report saved earlier. -->
                            <TextBlock Text="SCAN" Style="{StaticResource Caps}" Margin="2,0,0,6" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrimaryActionCommand}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding HasResults, Converter={x:Static cv:ScanLabel.Instance}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding CancelScanCommand}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" Content="Cancel scan" />
                            <Button Style="{StaticResource LinkButton}" Command="{Binding OpenReportCommand}" Margin="2,10,0,0" HorizontalAlignment="Left"
                                    Content="Open saved report…" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" ToolTip="Ctrl+1" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Overview}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Overview" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding HasResults}" ToolTip="Ctrl+2" IsChecked="{Binding FindingsNav}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Background="{StaticResource HighSoft}"
                                                Visibility="{Binding FlaggedFindingCount, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding FlaggedFindingCount}" Style="{StaticResource CountText}" FontWeight="SemiBold" Foreground="{StaticResource High}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Findings" />
                                    </DockPanel>
                                </RadioButton>

                                <TextBlock Text="EXECUTION" Style="{StaticResource Caps}" Margin="12,16,0,6" />
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding HasResults}" IsChecked="{Binding FilesNav}"
                                             ToolTip="Every program, jar, DLL and script, and the deleted ones - pick the kind at the top of the page  (Ctrl+3)">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding ProgramCount}" Style="{StaticResource CountText}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Programs &amp; files" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding HasResults}" ToolTip="Ctrl+4" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Commands}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding CommandCount}" Style="{StaticResource CountText}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Commands" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding Tamper.HasResults}" ToolTip="Program arguments  (Ctrl+5)" IsChecked="{Binding NavPage, Converter={StaticResource Is}, ConverterParameter=Tamper:Arguments}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Visibility="{Binding Tamper.FlaggedArguments, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Tamper.FlaggedArguments}" Style="{StaticResource CountText}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Arguments" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding Tamper.HasResults}" ToolTip="Ctrl+6" IsChecked="{Binding NavPage, Converter={StaticResource Is}, ConverterParameter=Tamper:Usb}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Background="{StaticResource Surface3}"
                                                Visibility="{Binding Tamper.HasResults, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Tamper.UsbCount}" Style="{StaticResource CountText}" Foreground="{StaticResource TextSub}" FontWeight="Normal" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="USB devices" />
                                    </DockPanel>
                                </RadioButton>

                                <TextBlock Text="RECORDS" Style="{StaticResource Caps}" Margin="12,16,0,6" />
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding HasResults}" ToolTip="Ctrl+7" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Timeline}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" />
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Timeline" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding HasResults}" ToolTip="Ctrl+8" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Memory}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE950;" />
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Memory strings" />
                                    </DockPanel>
                                </RadioButton>

                                <!-- Tampering and bypasses: the same scan, shown by the Tampering view (Tamper.*). -->
                                <TextBlock Text="TAMPERING" Style="{StaticResource Caps}" Margin="12,16,0,6" />
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding HasResults}" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Integrity}"
                                             ToolTip="Is the evidence trustworthy? Every source's health, clock changes, and the evidence services with their history  (Ctrl+9)">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Background="{StaticResource MediumSoft}"
                                                Visibility="{Binding IntegrityProblems, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding IntegrityProblems}" Style="{StaticResource CountText}" FontWeight="SemiBold" Foreground="{StaticResource Medium}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Integrity" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding Tamper.HasResults}" IsChecked="{Binding NavPage, Converter={StaticResource Is}, ConverterParameter=Tamper:Antivirus}"
                                             ToolTip="What protects the PC now, what the antivirus caught, when it was switched off and what it is told to skip  (Ctrl+Page Down from the page above)">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Background="{StaticResource MediumSoft}"
                                                Visibility="{Binding Tamper.AntivirusFlags, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Tamper.AntivirusFlags}" Style="{StaticResource CountText}" FontWeight="SemiBold" Foreground="{StaticResource Medium}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Antivirus" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding Tamper.HasResults}" ToolTip="Ctrl+Page Down from the page above" IsChecked="{Binding NavPage, Converter={StaticResource Is}, ConverterParameter=Tamper:Logs}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Visibility="{Binding Tamper.ProblemLogs, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Tamper.ProblemLogs}" Style="{StaticResource CountText}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Event logs" />
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsEnabled="{Binding Tamper.HasResults}" ToolTip="Ctrl+Page Down from the page above" IsChecked="{Binding NavPage, Converter={StaticResource Is}, ConverterParameter=Tamper:Evidence}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Count}" Visibility="{Binding Tamper.FlaggedEvidence, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Tamper.FlaggedEvidence}" Style="{StaticResource CountText}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource NavLabel}" Text="Evidence files" />
                                    </DockPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ================= Content ================= -->
                <DockPanel Grid.Column="1" Background="{StaticResource Bg}">
                <!-- A scan made without administrator rights is partial, and says so above every page: the lists still fill up, so
                     nothing else on a page shows what is missing from it. -->
                <Border DockPanel.Dock="Top" Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
                    <Border Background="{StaticResource HighSoft}" BorderBrush="#5A2A30" BorderThickness="0,0,0,1" Padding="28,7,20,7"
                            Visibility="{Binding ScanPartial, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Margin="14,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding RestartElevatedCommand}" Content="Restart as administrator"
                                    Visibility="{Binding IsElevated, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource High}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PartialText}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PartialText}" />
                        </DockPanel>
                    </Border>
                </Border>
                <Grid>

                    <!-- ===== Start ===== -->
                    <ScrollViewer Visibility="{Binding IsReady, Converter={StaticResource Vis}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1100" Margin="32,28,32,28">
                            <TextBlock Text="Screenshare scan" Style="{StaticResource H1}" FontSize="28"
                                       ToolTip="Reads what Windows itself records about the programs and commands that ran (Prefetch, BAM, PCA, UserAssist, ShimCache, Jump Lists, the change journal, event logs, the Recycle Bin, shell history, process memory), cross-checks the times, and checks whether those records can be trusted. It does not judge cheats by name: that is the job of Program Checker and Client Parser." />

                            <Border Margin="0,22,0,0" CornerRadius="{StaticResource RadiusL}" Padding="16,12" Background="{StaticResource HighSoft}"
                                    BorderBrush="#5A2A30" BorderThickness="1"
                                    Visibility="{Binding IsElevated, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RestartElevatedCommand}"
                                            Content="Restart as administrator" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource High}" Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Not running as administrator" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Prefetch, BAM, the USN journal, the Security log and service memory need admin rights. A scan now is incomplete." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Period: what the results open on. The scan reads everything whatever is chosen; a narrower period can be picked afterwards without scanning again. -->
                            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="12" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding BootText}" Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Period" Style="{StaticResource H2}"
                                                   ToolTip="What the results open on. Everything is read and cross-checked whatever is chosen; hashes and signatures are checked for the files in this period. A narrower period can be picked afterwards, in the title bar, without scanning again." />
                                    </DockPanel>
                                    <WrapPanel Margin="0,12,0,0">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=Game}" Content="Since the game started" ToolTip="From the start of the game that is running. With no game running, since sign-in." />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=SignIn}" Content="Since sign-in" ToolTip="From when this user signed in. One boot can span several sign-ins, so this is often later than the boot." />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=ThisBoot}" Content="This boot" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=Day}" Content="24 hours" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=ThreeDays}" Content="3 days" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=Week}" Content="7 days" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=Month}" Content="30 days" />
                                        <RadioButton Style="{StaticResource Chip}" GroupName="window" IsChecked="{Binding ScanWindow, Converter={StaticResource Is}, ConverterParameter=All}" Content="Everything" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Detection rules: defaults or a custom set for this screenshare -->
                            <TextBlock Text="Detection rules" Style="{StaticResource H2}" Margin="0,22,0,0"
                                       ToolTip="Which record-tampering commands and launch arguments get flagged. History Parser judges by what a command does to the records, not by program names." />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <RadioButton Style="{StaticResource ChoiceCard}" GroupName="rules"
                                             IsChecked="{Binding RulesMode, Converter={StaticResource Is}, ConverterParameter=Default}">
                                    <StackPanel>
                                        <TextBlock Text="Use default rules" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0">
                                            <Run Text="{Binding RulesSourceLabel, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding DefaultRulesSummary, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="2" Style="{StaticResource ChoiceCard}" GroupName="rules"
                                             IsChecked="{Binding RulesMode, Converter={StaticResource Is}, ConverterParameter=Custom}">
                                    <StackPanel>
                                        <TextBlock Text="Customize rules" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                                                   Text="Edit the flagged commands and program-argument rules for this screenshare, or load your server's rules file." />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsCustomRules, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" Command="{Binding LoadRulesCommand}" Margin="0,0,6,0"
                                                    ToolTip="Load a rules file (for example one shared by your staff team)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="Load file…" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" Command="{Binding SaveRulesCommand}" Margin="0,0,6,0"
                                                    ToolTip="Save these rules to a file you can reuse or share">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="Save file…" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" Command="{Binding ResetRulesCommand}"
                                                    ToolTip="Put the built-in default rules back">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="Reset to defaults" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Custom rules" Style="{StaticResource H2}" />
                                            <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Text="One entry per line. Lines starting with # are ignored." />
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="270" />
                                        </Grid.RowDefinitions>

                                        <TextBlock FontWeight="SemiBold" FontSize="13">
                                            <Run Text="Flagged commands" /> <Run Text="{Binding CommandRuleCount, Mode=OneWay}" Foreground="{StaticResource TextFaint}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,8">
                                            <Run Text="Commands that erase or tamper with the execution records." /><Run Text="   ·   " /><Run Text="pattern => why it is flagged" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text}" /><Run Text="   ·   plain text matches anywhere; " /><Run Text="/regex/" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text}" /><Run Text=" for patterns" />
                                        </TextBlock>
                                        <TextBox Grid.Row="2" Style="{StaticResource EditorBox}" Text="{Binding CommandsText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <TextBlock FontWeight="SemiBold" FontSize="13" Margin="0,16,0,0">
                                        <Run Text="Program arguments" /> <Run Text="{Binding Tamper.ArgumentRuleCount, Mode=OneWay}" Foreground="{StaticResource TextFaint}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,8">
                                        <Run Text="program: pattern => why it is flagged" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text}" /><Run Text="   ·   program is a file name like javaw.exe, or * for every program. Checked against running programs, process-creation logs and game / launcher logs (Program arguments page)." />
                                    </TextBlock>
                                    <TextBox Style="{StaticResource EditorBox}" Height="170" Text="{Binding Tamper.ArgumentsText, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Margin="0,10,0,0" Foreground="{StaticResource TextFaint}"
                                               Text="Names shorter than 6 letters must be a whole word of the file name (so &quot;drip&quot; does not match &quot;dripstone&quot;); longer names match anywhere. Nothing is saved on this PC unless you use Save file." />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" CornerRadius="{StaticResource RadiusL}" Padding="14,10" Background="{StaticResource HighSoft}"
                                    BorderBrush="#5A2A30" BorderThickness="1" Visibility="{Binding RulesError, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource High}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding RulesError}" TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="12.5" />
                                </DockPanel>
                            </Border>
                            <Border Margin="0,12,0,0" CornerRadius="{StaticResource RadiusL}" Padding="14,10" Background="{StaticResource HighSoft}"
                                    BorderBrush="#5A2A30" BorderThickness="1" Visibility="{Binding Tamper.RulesError, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource High}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="12.5">
                                        <Run Text="Program arguments:" FontWeight="SemiBold" /> <Run Text="{Binding Tamper.RulesError, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Options" Style="{StaticResource H2}" />
                                    <UniformGrid Columns="3" Margin="0,2,0,0">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScanMemory}" Content="Scan memory" Margin="0,12,20,0" ToolTip="Finds traces of programs in Explorer, Java and Windows services. Adds a few seconds." />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InspectFiles}" Content="Check signatures and hashes" Margin="0,12,20,0" ToolTip="Spots disguised, renamed or modified programs, and tells routine files from the rest. Turn off for a quicker scan." />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ReadGameLogs}" Content="Read game and launcher logs" Margin="0,12,20,0" ToolTip="Checks launch arguments in up to 90 days of game and launcher logs. Adds a few seconds." />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HidePrivate}" Content="Hide private details in reports" Margin="0,12,20,0" ToolTip="Saved reports mask the PC and user names and leave out personal history (the same switch is in the sidebar)." />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoSave}" Content="Save the report automatically" Margin="0,12,20,0" ToolTip="Writes an HTML and a JSON report to a &quot;Screenshare reports&quot; folder on this Desktop when the scan ends." />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartScanCommand}" Padding="26,12" FontSize="14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,10,0" />
                                        <TextBlock Text="Start scan with default rules" Visibility="{Binding IsCustomRules, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                        <TextBlock Text="Start scan with custom rules" Visibility="{Binding IsCustomRules, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenReportCommand}" Padding="18,12" Margin="12,0,0,0" FontSize="14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,10,0" />
                                        <TextBlock Text="Open saved report" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding BackToResultsCommand}" Margin="18,0,0,0" VerticalAlignment="Center"
                                        Content="← Back to the last results" FontSize="13" Visibility="{Binding HasPreviousResults, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource High}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Error, Converter={StaticResource Vis}}" />

                            <TextBlock Style="{StaticResource Sub}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="2,22,0,0">
                                <Run Text="Read-only" ToolTip="Nothing on this PC is changed, deleted or installed. No driver is loaded." /><Run Text="   ·   " /><Run Text="Offline" ToolTip="The scan never connects to the internet. Reports are only saved where you choose." /><Run Text="   ·   " /><Run Text="Open source" ToolTip="Not obfuscated. Decompile it with ILSpy to check it matches the published source." />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Scanning ===== -->
                    <Grid Visibility="{Binding IsScanning, Converter={StaticResource Vis}}">
                        <StackPanel Width="480" VerticalAlignment="Center">
                            <TextBlock Text="Scanning…" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Sub}" Margin="0,6,0,16" FontSize="13" />
                            <ProgressBar Style="{StaticResource Bar}" Minimum="0" Maximum="1" Value="{Binding Progress}" />
                            <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextFaint}"
                                       Text="Usually 10–30 seconds. Nothing on this PC is changed." />
                            <ItemsControl ItemsSource="{Binding ProgressLog}" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Ok}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSub}" FontSize="12.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Tampering pages (the same scan), picked from the sidebar ===== -->
                    <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Tamper}" Panel.ZIndex="5">
                        <tamper:TamperView DataContext="{Binding Tamper}" />
                    </Grid>

                    <!-- ===== Results ===== -->
                    <Grid Visibility="{Binding HasResults, Converter={StaticResource Vis}}">

                        <!-- Overview: where to look (one row per area of the scan), what the session's times are, and the period in numbers.
                             Each is a way in to the page that holds the detail; nothing here repeats that page. -->
                        <ScrollViewer Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Overview}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,22,28,28">
                                <DockPanel>
                                    <!-- The findings by strength: the count, and the way in to exactly those. -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                                        <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,0" Command="{Binding NavigateCommand}" CommandParameter="Findings:High" ToolTip="Show High findings">
                                            <TextBlock><Run Text="High" Foreground="{StaticResource TextSub}" />  <Run Text="{Binding HighCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource High}" /></TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,0" Command="{Binding NavigateCommand}" CommandParameter="Findings:Medium" ToolTip="Show Medium findings">
                                            <TextBlock><Run Text="Medium" Foreground="{StaticResource TextSub}" />  <Run Text="{Binding MediumCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Medium}" /></TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="14,8" Command="{Binding NavigateCommand}" CommandParameter="Findings:Low" ToolTip="Show Low findings">
                                            <TextBlock><Run Text="Low" Foreground="{StaticResource TextSub}" />  <Run Text="{Binding LowCount, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Overview" Style="{StaticResource H1}" />
                                        <TextBlock Text="{Binding MachineLine}" Style="{StaticResource Sub}" Margin="0,4,0,0" FontSize="13" />
                                        <TextBlock Text="{Binding ScanLine}" Style="{StaticResource Sub}" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- One row per area. Every kind of finding belongs to one of them, so a clean column of dots means a clean scan. -->
                                    <Border Style="{StaticResource Workspace}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource Strip}" Padding="18,13">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}" FontSize="12.5" VerticalAlignment="Center">
                                                        <Run Text="{Binding FlaggedFindingCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /> <Run Text="flagged" />
                                                    </TextBlock>
                                                    <TextBlock Text="WHERE TO LOOK" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ItemsControl x:Name="AreaList" ItemsSource="{Binding Areas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource RowButton}" Command="{Binding DataContext.NavigateCommand, ElementName=AreaList}" CommandParameter="{Binding Target}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="22" />
                                                                    <ColumnDefinition Width="168" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="22" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{Binding State, Converter={StaticResource Tone}}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="Ok">
                                                                                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Border Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Count, Converter={StaticResource Vis}}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource Count}">
                                                                            <Setter Property="Background" Value="{StaticResource MediumSoft}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="Bad">
                                                                                    <Setter Property="Background" Value="{StaticResource HighSoft}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Count}" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CountText}">
                                                                                <Setter Property="Foreground" Value="{StaticResource Medium}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Bad">
                                                                                        <Setter Property="Foreground" Value="{StaticResource High}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Grid.Column="4" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource TextFaint}"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- The times everything else is read against, in the order they happened. -->
                                    <Border Grid.Column="2" Style="{StaticResource Workspace}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource Strip}" Padding="18,13">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}" FontSize="12.5" VerticalAlignment="Center" Text="{Binding PeriodLabel, StringFormat=showing {0}}" />
                                                    <TextBlock Text="THIS SESSION" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding SessionMarks}" Margin="18,6,18,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="112" />
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,9,0,9" VerticalAlignment="Top" />
                                                            <!-- The rail: one line down the column, a dot on it for each time. -->
                                                            <Border Grid.Column="1" Width="1" Background="{StaticResource Line}" HorizontalAlignment="Center" />
                                                            <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,13,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                                     Stroke="{StaticResource Surface}" StrokeThickness="2" Fill="{Binding State, Converter={StaticResource Tone}}" />
                                                            <StackPanel Grid.Column="2" Margin="6,8,0,8">
                                                                <TextBlock Text="{Binding What}" FontSize="13" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"
                                                                           Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- The games found, each with what it was started with: which one a period is measured from is for the reader to see, and to pick. -->
                                            <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0" Padding="8,10,8,8">
                                                <StackPanel>
                                                    <DockPanel Margin="10,2,10,6">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show in the list" Command="{Binding NavigateCommand}" CommandParameter="Programs:Game" VerticalAlignment="Center"
                                                                Visibility="{Binding GameStartUtc, Converter={StaticResource Vis}}" ToolTip="Opens Programs &amp; files at the row where the game started  (Ctrl+G in a list)" />
                                                        <TextBlock Text="GAMES" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <ItemsControl x:Name="GameList" ItemsSource="{Binding Games}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MenuRow}" Command="{Binding DataContext.PickGameCommand, ElementName=GameList}" CommandParameter="{Binding Key}"
                                                                        IsEnabled="{Binding Enabled}" ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True">
                                                                    <DockPanel>
                                                                        <Grid DockPanel.Dock="Left" Width="22" VerticalAlignment="Top" Margin="0,3,0,0">
                                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Accent}" Visibility="{Binding IsPicked, Converter={StaticResource Vis}}" />
                                                                        </Grid>
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSub}" Margin="10,2,0,0" VerticalAlignment="Top" />
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Style="{StaticResource Sub}" FontSize="12.5" Margin="10,2,10,6" Text="No game is running and no earlier start is on record."
                                                               Visibility="{Binding Games.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- The period in numbers; each opens the list it counts. -->
                                <TextBlock Text="IN THIS PERIOD" Style="{StaticResource Caps}" Margin="2,24,0,8" />
                                <ItemsControl x:Name="ActivityList" ItemsSource="{Binding Activity}" Margin="-5,-5,-5,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CardButton}" Margin="5" Command="{Binding DataContext.NavigateCommand, ElementName=ActivityList}" CommandParameter="{Binding Target}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caps}" />
                                                    <TextBlock Text="{Binding Count, StringFormat=N0}" Style="{StaticResource StatValue}" FontSize="24" />
                                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Sub}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Unit}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- File pages: one list with a tab per kind of file -->
                        <Grid Visibility="{Binding IsFilePage, Converter={StaticResource Vis}}" Margin="28,22,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Programs &amp; files" Style="{StaticResource H1}" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{Binding FilePageSubtitle}" />

                            <!-- One surface: the kinds of file as tabs, the filters for the list, the list, and the panel for the row picked. -->
                            <Border Grid.Row="1" Style="{StaticResource Workspace}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource Strip}" Padding="8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Tab}" GroupName="filekind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Programs}"
                                                         ToolTip="Everything that was started: programs that ran, and the jars and scripts run through Java or an interpreter">
                                                <TextBlock><Run Text="All that ran" /> <Run Text="{Binding ProgramCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="filekind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Executables}"
                                                         ToolTip="Every .exe any source mentions: run, loaded, or only seen in a cache or in memory">
                                                <TextBlock><Run Text="Executables" /> <Run Text="{Binding ExeCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="filekind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Jars}"
                                                         ToolTip="Every .jar: run by Java, opened by another program, or only seen. The How column says which">
                                                <TextBlock><Run Text="JARs" /> <Run Text="{Binding JarCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="filekind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Dlls}"
                                                         ToolTip="Every library a program loaded, or that was seen in memory, caches or the change journal. Injected modules show up here">
                                                <TextBlock><Run Text="DLLs" /> <Run Text="{Binding DllCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="filekind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Scripts}"
                                                         ToolTip="Scripts an interpreter opened or a source mentions: .bat, .cmd, .ps1, .vbs, .py, .ahk and the like">
                                                <TextBlock><Run Text="Scripts" /> <Run Text="{Binding ScriptCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="filekind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Drivers}"
                                                         ToolTip="Kernel drivers (.sys): loaded now, installed as a service, or seen created or deleted">
                                                <TextBlock><Run Text="Drivers" /> <Run Text="{Binding DriverCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="filekind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Deleted}"
                                                         ToolTip="Files that ran or loaded and are now deleted, recycled, renamed or missing">
                                                <TextBlock><Run Text="Deleted" /> <Run Text="{Binding DeletedCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>

                                    <!-- Find a file · narrow the list (each chip says how many rows it leaves) · what is kept out of the way · what all that leaves. -->
                                    <Border Grid.Row="1" Style="{StaticResource Strip}" Padding="16,12,16,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Sub}" FontSize="13" Margin="18,0,0,8">
                                                <Run Text="{Binding VisibleFiles, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /> <Run Text="shown" />
                                            </TextBlock>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,7" Margin="18,0,0,8" VerticalAlignment="Center" Click="JumpToGame_Click"
                                                    Visibility="{Binding GameStartUtc, Converter={StaticResource Vis}}" ToolTip="Goes to the row where the game started  (Ctrl+G)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="Game start" />
                                                </StackPanel>
                                            </Button>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBox x:Name="FileSearchBox" Style="{StaticResource SearchBox}" ToolTip="Every word must be in the row. !word leaves rows with it out. &quot;Quotes&quot; keep words together." Width="300" Tag="Search name, path, hash, source…  (Ctrl+F)"
                                                         Text="{Binding FileSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding FlaggedOnly}" Margin="0,0,8,8" VerticalAlignment="Center"
                                                          ToolTip="Only files with a finding">
                                                    <TextBlock><Run Text="Flagged" /> <Run Text="{Binding FlaggedFiles, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                </CheckBox>
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding UnsignedOnly}" Margin="0,0,8,8" VerticalAlignment="Center"
                                                          ToolTip="Only programs and libraries with no signature, or with one that does not verify">
                                                    <TextBlock><Run Text="Unsigned" /> <Run Text="{Binding UnsignedFiles, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                </CheckBox>
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding GoneOnly}" Margin="0,0,8,8" VerticalAlignment="Center"
                                                          ToolTip="Only files that are deleted, recycled, renamed or missing now" Visibility="{Binding ShowGoneToggle, Converter={StaticResource Vis}}">
                                                    <TextBlock><Run Text="Deleted" /> <Run Text="{Binding GoneFiles, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                </CheckBox>
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding RanOnly}" Margin="0,0,8,8" VerticalAlignment="Center"
                                                          ToolTip="Only files that were started or loaded, leaving out the ones only seen in a cache, in memory or in the change journal"
                                                          Visibility="{Binding ShowRanToggle, Converter={StaticResource Vis}}">
                                                    <TextBlock><Run Text="Ran or loaded" /> <Run Text="{Binding RanFiles, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                </CheckBox>

                                                <Border Width="1" Height="20" Background="{StaticResource LineStrong}" Margin="6,0,14,8" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="FilesHiddenToggle" Style="{StaticResource HiddenToggle}" Margin="0,0,0,8" VerticalAlignment="Center"
                                                              ToolTip="Rows kept out of the way on this tab. Nothing is dropped: each kind has a switch, and a search looks through all of them.">
                                                    <TextBlock><Run Text="{Binding HiddenFiles, Mode=OneWay, StringFormat=N0}" /> <Run Text="hidden" /></TextBlock>
                                                </ToggleButton>
                                                <Popup IsOpen="{Binding IsChecked, ElementName=FilesHiddenToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                                       PlacementTarget="{Binding ElementName=FilesHiddenToggle}" Placement="Bottom">
                                                    <Border Style="{StaticResource PopupCard}" Width="380">
                                                        <StackPanel>
                                                            <TextBlock Text="KEPT OUT OF THE WAY ON THIS TAB" Style="{StaticResource Caps}" Margin="0,0,0,12" />
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeWindows}">
                                                                <TextBlock><Run Text="Routine files" /> <Run Text="{Binding RoutineCount, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                            </CheckBox>
                                                            <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="44,3,0,14"
                                                                       Text="On disk, signed by Microsoft or a known publisher (verified now, to the root), built under the name they have, and not a tool that runs other code. Never by folder or name." />
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowRepeats}">
                                                                <TextBlock><Run Text="Copies of a library" /> <Run Text="{Binding RepeatFiles, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                            </CheckBox>
                                                            <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="44,3,0,14"
                                                                       Text="The same DLL in other folders that never loaded. One row stays, marked ×N, with every copy listed in its panel." />
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowOwnTraces}">
                                                                <TextBlock><Run Text="This suite's own files" /> <Run Text="{Binding OwnFiles, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                            </CheckBox>
                                                            <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="44,3,0,0"
                                                                       Text="Exact copies of this build's programs and the runtime they unpack. Never counted as findings." />
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </WrapPanel>
                                        </DockPanel>
                                    </Border>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="348" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Two lines a row: the file, and the folder it is in. Read left to right as: what it is · how it got into the records · when · what state it is in. -->
                                        <DataGrid x:Name="FilesGrid" ItemsSource="{Binding FilesView}" SelectedItem="{Binding SelectedFile}" RowHeight="48"
                                                  Tag="No files here for the chosen time range, search and filters."
                                                  SelectionChanged="FilesGrid_SelectionChanged" ClipboardCopyMode="None">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy path" InputGestureText="Ctrl+C"
                                                              Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy file name"
                                                              Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Copy SHA-256"
                                                              Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Sha256, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="Open file location"
                                                              Command="{Binding PlacementTarget.DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Look up hash on VirusTotal (browser)"
                                                              Command="{Binding PlacementTarget.DataContext.VirusTotalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Sha256, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="42" MinWidth="42" SortMemberPath="SeverityRank" CanUserResize="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Width="9" Height="9" Fill="{Binding Severity, Converter={StaticResource Tone}}" HorizontalAlignment="Right"
                                                                     Visibility="{Binding Severity, Converter={StaticResource Vis}}" ToolTip="{Binding Severity}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="File" Width="*" MinWidth="240" SortMemberPath="Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                                                                <TextBlock FontSize="13.5" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding CopiesText, Mode=OneWay}" Foreground="{StaticResource AccentHover}" FontWeight="SemiBold" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Folder}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextFaint}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!-- How it got into the records: ran by itself, run by Java or an interpreter, or only opened by another program.
                                                     The tab already says what kind of file it is, so this column says the thing the kind does not. -->
                                                <DataGridTemplateColumn Header="How" Width="160" MinWidth="90" SortMemberPath="HowText">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding HowText}" Style="{StaticResource CellSub}" ToolTip="{Binding HowText}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Last run" Width="168" MinWidth="168" SortMemberPath="LastRunKey">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding LastRun, Converter={StaticResource Time}}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Status" Width="102" MinWidth="102" SortMemberPath="Status">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="{StaticResource RadiusS}" Padding="8,3" HorizontalAlignment="Left" ToolTip="{Binding StatusDetail}"
                                                                    Background="{Binding Status, Converter={StaticResource Tone}, ConverterParameter=soft}">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding Status, Converter={StaticResource Tone}}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Signed" Width="100" MinWidth="100" SortMemberPath="Signature">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Signature, Converter={StaticResource StatusText}}" Style="{StaticResource CellSub}" ToolTip="{Binding Signer}"
                                                                       Foreground="{Binding Signature, Converter={StaticResource Tone}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Grid.Column="1" Background="{StaticResource Line}" />
                                        <!-- Detail panel: part of the same surface as the list it describes -->
                                        <Border Grid.Column="2">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding SelectedFile, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="28" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Select a file to see every record of it" Style="{StaticResource Sub}" Margin="0,10,0,0" />
                                                </StackPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedFile, Converter={StaticResource Vis}}">
                                                    <StackPanel Margin="20,18,20,20" DataContext="{Binding SelectedFile}">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap" />
                                                        <TextBox Text="{Binding Path, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource MonoFont}"
                                                                 FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,8,0,0" />
                                                        <WrapPanel Margin="0,14,0,0">
                                                            <Border CornerRadius="{StaticResource RadiusS}" Padding="9,3" Margin="0,0,6,6" Background="{Binding Status, Converter={StaticResource Tone}, ConverterParameter=soft}">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding Status, Converter={StaticResource Tone}}" />
                                                            </Border>
                                                            <Border CornerRadius="{StaticResource RadiusS}" Padding="9,3" Margin="0,0,6,6" Background="{StaticResource NeutralSoft}">
                                                                <TextBlock Text="{Binding TypeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" />
                                                            </Border>
                                                            <Border CornerRadius="{StaticResource RadiusS}" Padding="9,3" Margin="0,0,6,6" Background="{StaticResource NeutralSoft}">
                                                                <TextBlock Text="{Binding HowText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Sub}" Margin="0,4,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                            <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" Content="Copy path" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}" />
                                                            <Button Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12.5" Content="Open location"
                                                                    Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}" />
                                                        </StackPanel>

                                                        <!-- The panel reads top to bottom as: which file · what can be done with it · its facts · what was found · the records behind it. -->
                                                        <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,0" />
                                                        <TextBlock Text="FILE" Style="{StaticResource Caps}" Margin="0,18,0,10" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="Last run" Style="{StaticResource Sub}" Margin="0,0,0,8" />
                                                            <TextBlock Grid.Column="1" Text="{Binding LastRun, Converter={StaticResource Time}}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                                                            <TextBlock Grid.Row="1" Text="Run count" Style="{StaticResource Sub}" Margin="0,0,0,8" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RunCount, TargetNullValue=—}" FontSize="13" />
                                                            <TextBlock Grid.Row="2" Text="Signature" Style="{StaticResource Sub}" Margin="0,0,0,8" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" TextWrapping="Wrap">
                                                                <Run Text="{Binding Signature, Converter={StaticResource StatusText}, Mode=OneWay}" />
                                                                <Run Text="{Binding Signer, Mode=OneWay}" Foreground="{StaticResource TextSub}" />
                                                            </TextBlock>
                                                            <TextBlock Grid.Row="3" Text="Size" Style="{StaticResource Sub}" Margin="0,0,0,8" />
                                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeText}" FontSize="13" />
                                                            <TextBlock Grid.Row="4" Text="SHA-256" Style="{StaticResource Sub}" />
                                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Sha256, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableText}"
                                                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                                            <TextBlock Grid.Row="5" Text="Built as" Style="{StaticResource Sub}" Margin="0,8,0,0"
                                                                       Visibility="{Binding VersionText, Converter={StaticResource Vis}}" />
                                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VersionText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                       Visibility="{Binding VersionText, Converter={StaticResource Vis}}" />
                                                            <TextBlock Grid.Row="6" Text="NTFS dates" Style="{StaticResource Sub}" Margin="0,8,0,0"
                                                                       Visibility="{Binding NtfsText, Converter={StaticResource Vis}}" />
                                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding NtfsText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding NtfsText, Converter={StaticResource Vis}}" />
                                                            <TextBlock Grid.Row="7" Text="Downloaded" Style="{StaticResource Sub}" Margin="0,8,0,0"
                                                                       Visibility="{Binding Record.DownloadedFrom, Converter={StaticResource Vis}}" />
                                                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Record.DownloadedFrom, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                                     FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Record.DownloadedFrom, Converter={StaticResource Vis}}" />
                                                        </Grid>

                                                        <TextBlock Text="FINDINGS" Style="{StaticResource Caps}" Margin="0,24,0,10"
                                                                   Visibility="{Binding Findings, Converter={StaticResource Vis}}" />
                                                        <ItemsControl ItemsSource="{Binding Findings}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="{StaticResource RadiusM}" Padding="14,12" Margin="0,0,0,8"
                                                                            Background="{Binding Severity, Converter={StaticResource Tone}, ConverterParameter=soft}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                                                                       Foreground="{Binding Severity, Converter={StaticResource Tone}}" />
                                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Foreground="{StaticResource Text}" Margin="0,5,0,0" FontSize="12.5" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- The copies folded under this row: the same library in other folders. -->
                                                        <StackPanel Visibility="{Binding HasCopies, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="ALSO AT" Style="{StaticResource Caps}" Margin="0,18,0,6" />
                                                            <TextBlock Text="{Binding CopiesWhy}" Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,10" />
                                                            <ItemsControl ItemsSource="{Binding Copies}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,10">
                                                                            <TextBox Text="{Binding Path, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                                                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0">
                                                                                <Run Text="{Binding Status, Converter={StaticResource StatusText}, Mode=OneWay}" /><Run Text="  ·  last record " /><Run Text="{Binding LastActivity, Converter={StaticResource Time}, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <TextBlock Margin="0,20,0,10"><Run Text="EVIDENCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" />  <Run Text="{Binding SourceCount, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextFaint}" /><Run Text=" sources" FontSize="11" Foreground="{StaticResource TextFaint}" /></TextBlock>
                                                        <ItemsControl ItemsSource="{Binding Evidence}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <!-- One record: where it came from and what it says happened and when, then the record's own words under it at full width. -->
                                                                    <StackPanel Margin="0,0,0,14">
                                                                        <DockPanel>
                                                                            <Border DockPanel.Dock="Left" CornerRadius="{StaticResource RadiusS}" Padding="8,2" Background="{StaticResource Surface3}" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding SourceText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" />
                                                                            </Border>
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time, Converter={StaticResource Time}}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                                                       Foreground="{StaticResource TextSub}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding KindText}" FontSize="12.5" FontWeight="SemiBold" Margin="9,0,8,0" VerticalAlignment="Center" />
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="12" Margin="0,5,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Findings: every lead, and the ones about dates that disagree, as two tabs of one list -->
                        <Grid Visibility="{Binding IsFindingPage, Converter={StaticResource Vis}}" Margin="28,22,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                        Command="{Binding NavigateCommand}" CommandParameter="Tamper:Overview" Content="Tampering summary →" />
                                <TextBlock Text="Findings" Style="{StaticResource H1}" VerticalAlignment="Center"
                                           ToolTip="Strongest first, executions and tampering together. High is something that cannot happen on an untouched PC." />
                            </DockPanel>
                            <!-- The same surface as every list: which findings as tabs · find and narrow · the list · the whole finding for the row picked. -->
                            <Border Grid.Row="1" Style="{StaticResource Workspace}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource Strip}" Padding="8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Tab}" GroupName="findkind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Findings}"
                                                         ToolTip="Every finding of the scan">
                                                <TextBlock><Run Text="All findings" /> <Run Text="{Binding FlaggedFindingCount, Mode=OneWay}" Foreground="{StaticResource TextFaint}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="findkind" IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Inconsistencies}"
                                                         ToolTip="Only where the sources disagree about when something happened: clock changes, runs recorded after a deletion, launches missing from Prefetch, files swapped after they ran">
                                                <TextBlock><Run Text="Date inconsistencies" /> <Run Text="{Binding InconsistencyCount, Mode=OneWay}" Foreground="{StaticResource TextFaint}" /></TextBlock>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource Strip}" Padding="16,12,16,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Sub}" FontSize="13" Margin="18,0,0,8">
                                                <Run Text="{Binding ActiveFindings.Count, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /> <Run Text="shown" />
                                            </TextBlock>
                                            <!-- Find · narrow to a severity (each chip says how many there are; none picked is all of them) · what is kept out of the way. -->
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBox x:Name="FindingSearchBox" Style="{StaticResource SearchBox}" ToolTip="Every word must be in the row. !word leaves rows with it out. &quot;Quotes&quot; keep words together." Width="300" Tag="Search findings…  (Ctrl+F)"
                                                         Text="{Binding FindingSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding ShowHigh}" Margin="0,0,8,8" VerticalAlignment="Center"
                                                          ToolTip="Something that cannot happen on an untouched PC">
                                                    <TextBlock><Run Text="High" /> <Run Text="{Binding HighOnTab, Mode=OneWay, StringFormat=N0}" Foreground="{StaticResource High}" /></TextBlock>
                                                </CheckBox>
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding ShowMedium}" Margin="0,0,8,8" VerticalAlignment="Center"
                                                          ToolTip="Worth a look: unusual, and often explained by something ordinary">
                                                    <TextBlock><Run Text="Medium" /> <Run Text="{Binding MediumOnTab, Mode=OneWay, StringFormat=N0}" Foreground="{StaticResource Medium}" /></TextBlock>
                                                </CheckBox>
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding ShowLow}" Margin="0,0,8,8" VerticalAlignment="Center"
                                                          ToolTip="Context: true, and not suspicious by itself">
                                                    <TextBlock><Run Text="Low" /> <Run Text="{Binding LowOnTab, Mode=OneWay, StringFormat=N0}" Foreground="{StaticResource Low}" /></TextBlock>
                                                </CheckBox>

                                                <Border Width="1" Height="20" Background="{StaticResource LineStrong}" Margin="6,0,14,8" VerticalAlignment="Center" />
                                                <ToggleButton x:Name="FindingsHiddenToggle" Style="{StaticResource HiddenToggle}" Margin="0,0,0,8" VerticalAlignment="Center"
                                                              ToolTip="Findings kept out of the way on this tab. Nothing is dropped: there is a switch to show them.">
                                                    <TextBlock><Run Text="{Binding HiddenFindings, Mode=OneWay, StringFormat=N0}" /> <Run Text="hidden" /></TextBlock>
                                                </ToggleButton>
                                                <Popup IsOpen="{Binding IsChecked, ElementName=FindingsHiddenToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                                       PlacementTarget="{Binding ElementName=FindingsHiddenToggle}" Placement="Bottom">
                                                    <Border Style="{StaticResource PopupCard}" Width="380">
                                                        <StackPanel>
                                                            <TextBlock Text="KEPT OUT OF THE WAY ON THIS TAB" Style="{StaticResource Caps}" Margin="0,0,0,12" />
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowOwnTraces}">
                                                                <TextBlock><Run Text="About this suite's own traces" /> <Run Text="{Binding OwnFindings, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                            </CheckBox>
                                                            <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="44,3,0,0"
                                                                       Text="What these programs left themselves: their runs, the runtime they unpack, the launcher command. Marked, and never counted." />
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </WrapPanel>
                                        </DockPanel>
                                    </Border>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="380" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Two lines a row: what was found, and the start of why. Rows sort by any column; they open strongest first. -->
                                        <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding ActiveFindings}" SelectedItem="{Binding SelectedFinding}" RowHeight="50" ClipboardCopyMode="None"
                                                  Tag="No findings for the chosen severity, search and time range.">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy finding" InputGestureText="Ctrl+C"
                                                              Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Detail, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy path"
                                                              Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="Show file record"
                                                              Command="{Binding PlacementTarget.DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Severity" Width="92" MinWidth="92" SortMemberPath="Severity">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SeverityPill}" VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Finding" Width="*" MinWidth="260" SortMemberPath="Title">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <!-- One line of it: a detail of several lines must not push its title out of the row. -->
                                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSub}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxHeight="17" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Area" Width="136" MinWidth="80" SortMemberPath="Category">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryText}}" Style="{StaticResource CellSub}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Time" Width="168" MinWidth="168" SortMemberPath="TimeUtc">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TimeUtc, Converter={StaticResource Time}}" Style="{StaticResource CellMono}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Grid.Column="1" Background="{StaticResource Line}" />
                                        <Border Grid.Column="2">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding SelectedFinding, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="28" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Select a finding to read all of it" Style="{StaticResource Sub}" Margin="0,10,0,0" />
                                                </StackPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedFinding, Converter={StaticResource Vis}}">
                                                    <StackPanel Margin="18" DataContext="{Binding SelectedFinding}">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="16" TextWrapping="Wrap" />
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SeverityPill}" Margin="0,0,6,6" />
                                                            <Border CornerRadius="{StaticResource RadiusS}" Padding="8,2" Margin="0,0,6,6" Background="{StaticResource NeutralSoft}">
                                                                <TextBlock Text="{Binding Category, Converter={StaticResource CategoryText}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Content="Copy" Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Detail}" />
                                                            <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Content="Show file record"
                                                                    Visibility="{Binding Path, Converter={StaticResource Vis}}" ToolTipService.ShowOnDisabled="True"
                                                                    ToolTip="Opens this file on the Programs page (greyed out when the file has no record there, e.g. a log path)"
                                                                    Command="{Binding DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}" />
                                                        </StackPanel>

                                                        <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,0" />
                                                        <TextBlock Text="WHAT WAS FOUND" Style="{StaticResource Caps}" Margin="0,14,0,8" />
                                                        <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="12.5" />

                                                        <StackPanel Visibility="{Binding Path, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="FILE" Style="{StaticResource Caps}" Margin="0,18,0,8" />
                                                            <TextBox Text="{Binding Path, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                                        </StackPanel>

                                                        <TextBlock Text="RECORD" Style="{StaticResource Caps}" Margin="0,18,0,8" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Time" Style="{StaticResource Sub}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TimeUtc, Converter={StaticResource Time}}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                                        </Grid>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Commands -->
                        <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Commands}" Margin="28,22,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Commands" Style="{StaticResource H1}"
                                       ToolTip="PowerShell history, open cmd / terminal windows, Windows Terminal tabs, Git Bash, the Run box, Explorer, running shells and the PowerShell event logs. Newest first; a history file that keeps no times follows in its own order." />
                            <!-- The same surface as every list: where the command came from as tabs · find and narrow · the list · the whole command for the row picked. -->
                            <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource Workspace}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource Strip}" Padding="8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter=All}">
                                                <TextBlock><Run Text="All" /> <Run Text="{Binding CommandCount, Mode=OneWay}" Foreground="{StaticResource TextFaint}" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" Content="PowerShell" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter=PowerShell}" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" Content="CMD / Terminal" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter='CMD / Terminal'}" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" Content="Run box" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter='Run box'}" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" Content="Explorer" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter=Explorer}" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" Content="Bash" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter=Bash}" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" Content="Running now" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter=Running}" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="cgroup" Content="Event logs" IsChecked="{Binding CommandGroup, Converter={StaticResource Is}, ConverterParameter='Event log'}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource Strip}" Padding="16,12,16,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Sub}" FontSize="13" Margin="18,0,0,8">
                                                <Run Text="{Binding VisibleCommands, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /> <Run Text="shown" />
                                            </TextBlock>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBox x:Name="CommandSearchBox" Style="{StaticResource SearchBox}" ToolTip="Every word must be in the row. !word leaves rows with it out. &quot;Quotes&quot; keep words together." Width="300" Tag="Search commands…  (Ctrl+F)"
                                                         Text="{Binding CommandSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                                <CheckBox Style="{StaticResource FilterChip}" IsChecked="{Binding SuspiciousOnly}" VerticalAlignment="Center" Margin="0,0,0,8"
                                                          ToolTip="Only commands a rule flagged">
                                                    <TextBlock><Run Text="Flagged" /> <Run Text="{Binding FlaggedCommands, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                </CheckBox>
                                            </WrapPanel>
                                        </DockPanel>
                                    </Border>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="380" />
                                        </Grid.ColumnDefinitions>
                            <Border>
                                <Grid>
                                    <DataGrid x:Name="CommandsGrid" ItemsSource="{Binding CommandsView}" SelectedItem="{Binding SelectedCommand}" ClipboardCopyMode="None" Tag="No commands here for the chosen time range, search and filters.">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy command" InputGestureText="Ctrl+C"
                                                          Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.Command, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="42" MinWidth="42" SortMemberPath="IsSuspicious" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Medium}" ToolTip="{Binding Suspicion}"
                                                                 Visibility="{Binding IsSuspicious, Converter={StaticResource Vis}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Time" Width="168" MinWidth="168" SortMemberPath="Time">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Time, Converter={StaticResource Time}}" Style="{StaticResource CellMono}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <!-- The command is what is read, so it comes straight after its time and gets the room; where it came from follows.
                                                 Who ran it, the full text and why it was flagged are in the panel for the row picked. -->
                                            <DataGridTemplateColumn Header="Command" Width="*" MinWidth="240" SortMemberPath="Command">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Command}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="From" Width="250" MinWidth="120" SortMemberPath="Source">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Source}" Style="{StaticResource CellSub}" ToolTip="{Binding Detail}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                                        <Border Grid.Column="1" Background="{StaticResource Line}" />
                                        <Border Grid.Column="2">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding SelectedCommand, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="28" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Select a command to read all of it" Style="{StaticResource Sub}" Margin="0,10,0,0" />
                                                </StackPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedCommand, Converter={StaticResource Vis}}">
                                                    <StackPanel Margin="18" DataContext="{Binding SelectedCommand}">
                                                        <TextBlock Text="{Binding Source}" Style="{StaticResource H2}" FontSize="15" TextWrapping="Wrap" />
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Border CornerRadius="{StaticResource RadiusS}" Padding="8,2" Margin="0,0,6,6" Background="{StaticResource NeutralSoft}">
                                                                <TextBlock Text="{Binding Group}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" />
                                                            </Border>
                                                            <Border CornerRadius="{StaticResource RadiusS}" Padding="8,2" Margin="0,0,6,6" Background="{StaticResource MediumSoft}"
                                                                    Visibility="{Binding IsSuspicious, Converter={StaticResource Vis}}">
                                                                <TextBlock Text="Flagged" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Medium}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Content="Copy command" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Command}" />

                                                        <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,0" />
                                                        <TextBlock Text="COMMAND" Style="{StaticResource Caps}" Margin="0,14,0,8" />
                                                        <TextBox Text="{Binding Command, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource MonoFont}" FontSize="12" />

                                                        <StackPanel Visibility="{Binding IsSuspicious, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="WHY FLAGGED" Style="{StaticResource Caps}" Margin="0,18,0,8" />
                                                            <Border CornerRadius="{StaticResource RadiusM}" Padding="12,10" Background="{StaticResource MediumSoft}">
                                                                <TextBlock Text="{Binding Suspicion}" Foreground="{StaticResource Medium}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="RECORD" Style="{StaticResource Caps}" Margin="0,18,0,8" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="Time" Style="{StaticResource Sub}" Margin="0,0,0,6" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Time, Converter={StaticResource Time}, TargetNullValue='Not recorded by this source'}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                                            <TextBlock Grid.Row="1" Text="User" Style="{StaticResource Sub}" Margin="0,0,0,6" Visibility="{Binding User, Converter={StaticResource Vis}}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding User}" FontSize="12.5" TextWrapping="Wrap" Visibility="{Binding User, Converter={StaticResource Vis}}" />
                                                            <TextBlock Grid.Row="2" Text="Where" Style="{StaticResource Sub}" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Sub}" Foreground="{StaticResource Text}" FontSize="12" />
                                                        </Grid>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Timeline -->
                        <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Timeline}" Margin="28,22,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Timeline" Style="{StaticResource H1}" ToolTip="Every record from every source in one list, newest first." />
                            <!-- The same surface as every list: the kind of record as tabs · find and narrow · the records. Wide on purpose: a record is read across. -->
                            <Border Grid.Row="1" Style="{StaticResource Workspace}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource Strip}" Padding="8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Tab}" GroupName="tkind" Content="All" IsChecked="{Binding TimelineKind, Converter={StaticResource Is}, ConverterParameter=All}" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="tkind" Content="Ran" IsChecked="{Binding TimelineKind, Converter={StaticResource Is}, ConverterParameter=Ran}"
                                                         ToolTip="The file itself was started" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="tkind" Content="Loaded" IsChecked="{Binding TimelineKind, Converter={StaticResource Is}, ConverterParameter=Loaded}"
                                                         ToolTip="Another program loaded or opened the file" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="tkind" Content="Seen" IsChecked="{Binding TimelineKind, Converter={StaticResource Is}, ConverterParameter=Seen}"
                                                         ToolTip="A source mentions the file without saying it ran" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="tkind" Content="Deleted" IsChecked="{Binding TimelineKind, Converter={StaticResource Is}, ConverterParameter=Deleted}"
                                                         ToolTip="Deleted or sent to the Recycle Bin" />
                                            <RadioButton Style="{StaticResource Tab}" GroupName="tkind" Content="Changed" IsChecked="{Binding TimelineKind, Converter={StaticResource Is}, ConverterParameter=Changed}"
                                                         ToolTip="Created, renamed, modified, hard-linked, or its dates were changed" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource Strip}" Padding="16,12,16,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Sub}" FontSize="13" Margin="18,0,0,8">
                                                <Run Text="{Binding VisibleTimeline, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /> <Run Text="shown" />
                                            </TextBlock>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,7" Margin="18,0,0,8" VerticalAlignment="Center" Click="JumpToGame_Click"
                                                    Visibility="{Binding GameStartUtc, Converter={StaticResource Vis}}" ToolTip="Goes to the row where the game started  (Ctrl+G)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="Game start" />
                                                </StackPanel>
                                            </Button>
                                            <!-- The same records two ways: one row each, or gathered by the folder they are in. -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,8">
                                                <RadioButton Style="{StaticResource Chip}" GroupName="tlayout" Content="Records" Margin="0,0,6,0" ToolTip="One row per record"
                                                             IsChecked="{Binding TimelineLayout, Converter={StaticResource Is}, ConverterParameter=Records}" />
                                                <RadioButton Style="{StaticResource Chip}" GroupName="tlayout" Content="By folder" Margin="0" ToolTip="One row per folder, newest first, with its records beside it"
                                                             IsChecked="{Binding TimelineLayout, Converter={StaticResource Is}, ConverterParameter=Folders}" />
                                            </StackPanel>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBox x:Name="TimelineSearchBox" Style="{StaticResource SearchBox}" ToolTip="Every word must be in the row. !word leaves rows with it out. &quot;Quotes&quot; keep words together." Width="300" Tag="Search path, source or detail…  (Ctrl+F)"
                                                         Text="{Binding TimelineSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                                <ToggleButton x:Name="TimelineHiddenToggle" Style="{StaticResource HiddenToggle}" Margin="0,0,0,8" VerticalAlignment="Center"
                                                              ToolTip="Records kept out of the way on this tab. Nothing is dropped: there is a switch to show them, and a search looks through them.">
                                                    <TextBlock><Run Text="{Binding HiddenRecords, Mode=OneWay, StringFormat=N0}" /> <Run Text="hidden" /></TextBlock>
                                                </ToggleButton>
                                                <Popup IsOpen="{Binding IsChecked, ElementName=TimelineHiddenToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                                       PlacementTarget="{Binding ElementName=TimelineHiddenToggle}" Placement="Bottom">
                                                    <Border Style="{StaticResource PopupCard}" Width="380">
                                                        <StackPanel>
                                                            <TextBlock Text="KEPT OUT OF THE WAY ON THIS TAB" Style="{StaticResource Caps}" Margin="0,0,0,12" />
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TimelineIncludeWindows}">
                                                                <TextBlock><Run Text="Records of routine files" /> <Run Text="{Binding RoutineRecords, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                            </CheckBox>
                                                            <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="44,3,0,14"
                                                                       Text="Every record of a file verified as routine, and of Windows' own data files in its folder that never ran." />
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowOwnTraces}">
                                                                <TextBlock><Run Text="This suite's own records" /> <Run Text="{Binding OwnRecords, Mode=OneWay, StringFormat=N0}" Style="{StaticResource ChipCount}" /></TextBlock>
                                                            </CheckBox>
                                                            <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="44,3,0,0"
                                                                       Text="Records of exact copies of this build's programs: what the scan itself left behind. The same switch as on the file pages." />
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </WrapPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataGrid Grid.Row="2" x:Name="TimelineGrid" ItemsSource="{Binding TimelineView}" Visibility="{Binding TimelineByFolder, Converter={StaticResource Vis}, ConverterParameter=invert}" ClipboardCopyMode="None" Tag="No records here for the chosen kind, search and time range.">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy path" InputGestureText="Ctrl+C"
                                                          Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Copy detail"
                                                          Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.Detail, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Show file record"
                                                          Command="{Binding PlacementTarget.DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Time" Width="168" MinWidth="168" SortMemberPath="Time">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Time, Converter={StaticResource Time}}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Event" Width="104" MinWidth="80" SortMemberPath="KindText">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="File / item" Width="2*" MinWidth="200" SortMemberPath="Path">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" ToolTip="{Binding Path}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Source" Width="110" MinWidth="80" SortMemberPath="SourceText">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource CellSub}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Detail" Width="2*" MinWidth="160" SortMemberPath="Detail">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CellSub}" ToolTip="{Binding Detail}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <!-- The same records by folder: the folders something happened in, newest first, and the records of the one picked. -->
                                    <Grid Grid.Row="2" Visibility="{Binding TimelineByFolder, Converter={StaticResource Vis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*" MinWidth="320" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="5*" MinWidth="320" />
                                        </Grid.ColumnDefinitions>
                                        <DataGrid x:Name="FolderGrid" ItemsSource="{Binding FolderGroups}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" ClipboardCopyMode="None"
                                                  Tag="No folders here for the chosen kind, search and time range.">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy folder"
                                                              Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Folder, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Open folder"
                                                              Command="{Binding PlacementTarget.DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem.Folder, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Latest" Width="168" MinWidth="168" SortMemberPath="Latest">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Latest, Converter={StaticResource Time}}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Folder" Width="*" MinWidth="160" SortMemberPath="Folder">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" ToolTip="{Binding Folder}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Files" Width="66" MinWidth="56" SortMemberPath="Files">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Files, StringFormat=N0}" Style="{StaticResource CellText}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Ran" Width="60" MinWidth="52" SortMemberPath="Ran">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Ran, StringFormat=N0}" Style="{StaticResource CellText}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Deleted" Width="78" MinWidth="64" SortMemberPath="Deleted">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Deleted, StringFormat=N0}" Style="{StaticResource CellText}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Changed" Width="82" MinWidth="64" SortMemberPath="Changed">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Changed, StringFormat=N0}" Style="{StaticResource CellText}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Grid.Column="1" Background="{StaticResource Line}" />
                                        <DockPanel Grid.Column="2">
                                            <Border DockPanel.Dock="Top" Style="{StaticResource Strip}" Padding="16,11" Visibility="{Binding SelectedFolder, Converter={StaticResource Vis}}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}" FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <Run Text="{Binding SelectedFolder.Records, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /> <Run Text="records" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SelectedFolder.Folder}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFolder.Folder}" />
                                                </DockPanel>
                                            </Border>
                                            <DataGrid x:Name="FolderRecordsGrid" ItemsSource="{Binding SelectedFolder.Rows}" ClipboardCopyMode="None" Tag="Pick a folder to see its records.">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Copy path" InputGestureText="Ctrl+C"
                                                                  Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Show file record"
                                                                  Command="{Binding PlacementTarget.DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Time" Width="168" MinWidth="168" SortMemberPath="Time">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Time, Converter={StaticResource Time}}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Event" Width="96" MinWidth="80" SortMemberPath="KindText">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="File" Width="*" MinWidth="140" SortMemberPath="Name">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" ToolTip="{Binding Path}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Source" Width="128" MinWidth="90" SortMemberPath="SourceText">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource CellText}" ToolTip="{Binding Detail}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Memory -->
                        <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Memory}" Margin="28,22,28,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Memory strings" Style="{StaticResource H1}"
                                       ToolTip="Program paths found in the memory of Explorer, DPS, PcaSvc, DiagTrack, Appinfo, DcomLaunch and running Java processes. They outlive the file until the process restarts." />
                            <Border Grid.Row="1" Style="{StaticResource Workspace}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource Strip}" Padding="16,12,16,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Sub}" Margin="16,0,0,8">
                                                <Run Text="{Binding MemoryView.Count, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{StaticResource Text}" /> <Run Text="shown" />
                                            </TextBlock>
                                            <TextBox x:Name="MemorySearchBox" Style="{StaticResource SearchBox}" ToolTip="Every word must be in the row. !word leaves rows with it out. &quot;Quotes&quot; keep words together." Width="280" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                     Tag="Search path or process…  (Ctrl+F)" Text="{Binding MemorySearch, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" x:Name="MemoryGrid" ItemsSource="{Binding MemoryView}" ClipboardCopyMode="None" Tag="No program paths were read from memory (reading it needs administrator), or none match the search.">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy path" InputGestureText="Ctrl+C"
                                                          Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Copy raw string"
                                                          Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.Raw, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Show file record"
                                                          Command="{Binding PlacementTarget.DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Process" Width="190" MinWidth="120" SortMemberPath="Process">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource CellText}">
                                                            <Run Text="{Binding Process, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="{Binding Pid, Mode=OneWay}" Foreground="{StaticResource TextFaint}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Path" Width="2*" MinWidth="200" SortMemberPath="Path">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource CellMono}" Foreground="{StaticResource Text}" ToolTip="{Binding Raw}"
                                                                   Text="{Binding Path, Mode=OneWay}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Recorded time (DPS)" Width="170" MinWidth="120" SortMemberPath="RecordedTime">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RecordedTime, TargetNullValue=—}" Style="{StaticResource CellMono}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Raw string" Width="*" MinWidth="160" SortMemberPath="Raw">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Raw}" Style="{StaticResource CellMono}" ToolTip="{Binding Raw}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Integrity -->
                        <ScrollViewer Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Integrity}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,22,28,28">
                                <TextBlock Text="Integrity &amp; services" Style="{StaticResource H1}" Margin="0,0,0,14"
                                           ToolTip="Every source's health, clock changes, and the services that record evidence: their state now and every stop or change." />

                                <Border Style="{StaticResource Card}" Padding="0">
                                    <ItemsControl ItemsSource="{Binding IntegrityChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource Tone}}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Area}" Foreground="{StaticResource TextFaint}" FontSize="12.5" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Sub}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="Clock changes" Style="{StaticResource H2}" Margin="0,26,0,10" />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding ClockChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20" />
                                                                <ColumnDefinition Width="230" />
                                                                <ColumnDefinition Width="340" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Severity, Converter={StaticResource Tone}}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Source}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" FontFamily="{StaticResource MonoFont}" FontSize="12">
                                                                <Run Text="{Binding OldTimeUtc, Converter={StaticResource Time}, Mode=OneWay}" />
                                                                <Run Text=" → " Foreground="{StaticResource TextFaint}" />
                                                                <Run Text="{Binding NewTimeUtc, Converter={StaticResource Time}, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Sub}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="16,12" Style="{StaticResource Sub}" Text="No clock changes found. Normal sleep/resume re-syncs and small time-service corrections are ignored."
                                                   Visibility="{Binding ClockChanges, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Evidence services now" Style="{StaticResource H2}" Margin="0,26,0,4" Visibility="{Binding Tamper.HasResults, Converter={StaticResource Vis}}" />
                                <TextBlock Text="SysMain (Prefetch), BAM, DPS, PcaSvc, EventLog and the others that record what ran. A red one is off, stopped or was changed in a way Windows does not do itself."
                                           Style="{StaticResource Sub}" Margin="0,0,0,10" Visibility="{Binding Tamper.HasResults, Converter={StaticResource Vis}}" />
                                <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding Tamper.HasResults, Converter={StaticResource Vis}}">
                                    <ItemsControl ItemsSource="{Binding Tamper.ServicesList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource Tone}}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="{StaticResource TextFaint}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="3" FontSize="12.5">
                                                            <Run Text="{Binding State, Mode=OneWay}" /> <Run Text="·" Foreground="{StaticResource TextFaint}" /> <Run Text="{Binding StartType, Mode=OneWay}" Foreground="{StaticResource TextSub}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="4" Text="{Binding Note}" Style="{StaticResource Sub}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="Service history" Style="{StaticResource H2}" Margin="0,26,0,4" />
                                <TextBlock Text="Stops, start-type changes and crashes of the services that record evidence. Red rows are the ones not explained by a shutdown, an update or Windows itself."
                                           Style="{StaticResource Sub}" Margin="0,0,0,10" />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding ServiceHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Ok, Converter={StaticResource Tone}}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TimeUtc, Converter={StaticResource Time}}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Service}" FontWeight="SemiBold" FontSize="12.5" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Change}" Style="{StaticResource Sub}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="16,12" Style="{StaticResource Sub}" Text="No service stops or changes recorded for the evidence services."
                                                   Visibility="{Binding ServiceHistory, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Sources" Style="{StaticResource H2}" Margin="0,26,0,10" />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <ItemsControl ItemsSource="{Binding Sources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="260" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Success, Converter={StaticResource Tone}}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Sub}"><Run Text="{Binding Items, Mode=OneWay, StringFormat=N0}" /> <Run Text="items" /></TextBlock>
                                                        <TextBlock Grid.Column="3" Style="{StaticResource Sub}" Text="{Binding Duration.TotalSeconds, StringFormat={}{0:0.0} s}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Message}" Style="{StaticResource Sub}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Help (available in every state) ===== -->
                    <ScrollViewer Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Help}"
                                  VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
                        <StackPanel Margin="28,22,28,32" MaxWidth="1100" HorizontalAlignment="Left">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="← Back" VerticalAlignment="Top"
                                        Command="{Binding NavigateCommand}" CommandParameter="Overview" />
                                <StackPanel>
                                    <TextBlock Text="Help" Style="{StaticResource H1}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0">
                                        <Run Text="History Parser" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /> <Run Text="· everything you need to run a screenshare with it." />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <!-- Quick start -->
                            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quick start" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" FontSize="13" LineHeight="22" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="1." /> Have the player keep Minecraft open, run HistoryParser.exe and click Yes on the administrator prompt — without it, Prefetch, BAM, Amcache, the USN journal, the Security log and the game checks cannot be read.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="2." /> Pick a period (This boot is usually right), the rules and options, then start the scan. It usually takes about a minute. A narrower period (since sign-in, since the game started) can be picked afterwards from the title bar without scanning again.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="3." /> Read Overview, then All findings — strongest first, executions and tampering together. Click a finding's file path to open that file's full record.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="4." /> Check Deleted and Commands, then search All programs for anything the player was asked about.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="5." /> Look at Integrity: a disabled or wiped source means the other pages are incomplete, which is a finding in itself.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="6." /> Go through the Tampering section: it shows whether the records were tampered with — logs cleared, services stopped, evidence files deleted, record-erasing commands or arguments run.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="7." /> Export HTML to share with staff, or JSON to reopen the exact same report later with "Open saved report". Both hold executions and tampering.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- The tampering half of the scan -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Tampering — are the records trustworthy?" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="Integrity &amp; services" /> — whether each evidence source is on, recent and readable; evidence services disabled, stopped, killed or reconfigured, and who did it (Windows or a user); clock changes.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="Event logs" /> — logs turned off, shrunk, cleared, or with single events deleted (gaps in the record numbers).<LineBreak />
                                        <Run FontWeight="SemiBold" Text="Evidence files" /> — event logs, Prefetch, Amcache, recent items, jump lists, shell history and PCA logs deleted or emptied; programs deleted right before the scan.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="USB devices" /> — USB drives connected in the period or plugged in now, and programs that ran from one.<LineBreak />
                                        <Run FontWeight="SemiBold" Text="Program arguments" /> — the command lines programs were launched with, checked against your argument rules; encoded PowerShell is decoded.<LineBreak /><LineBreak />
                                        Click a row on these pages for everything about it; Ctrl+F searches every column; CSV exports the table as shown. Program-argument rules are edited with the command rules on the start screen (Customize rules) and saved in the same rules file, under [arguments].
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Time range -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Choosing a time range" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                        The range only decides what is shown. The scan still reads and cross-checks everything, so a file deleted today is still compared with
                                        a run from weeks ago, and problems the PC has right now (a service disabled, a log turned off) always show.<LineBreak /><LineBreak />
                                        <Run FontWeight="SemiBold" Text="This boot" /> starts when Windows last started; the start screen shows when that was. With Windows' Fast Startup on (the default
                                        on most PCs), "Shut down" does not end a boot — only Restart does — so one boot can cover several days. Pick 24 hours or 3 days when you
                                        want a fixed period.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <!-- Pages -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Pages" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Text="Findings" /> — every lead, strongest first; the Date inconsistencies tab keeps the ones where sources disagree about when something happened.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Programs &amp; files" /> — one list with a tab per kind. All that ran: everything that was started, including scripts and jars run through Java. Executables, JARs, DLLs, Scripts, Drivers: every file of that kind any source mentions. Deleted: ran, and now deleted, recycled, renamed or missing. The How column says whether a file ran, was run by Java or an interpreter, or was only opened by another program.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Commands" /> — PowerShell, cmd / terminal, Run box, Explorer search, Bash and logged commands, newest first; the panel shows the whole command.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Timeline / Memory strings" /> — every raw record with a tab per kind of event, and the program paths found in process memory.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Integrity &amp; services" /> — whether each evidence source is on, recent and readable, plus clock and service history.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Statuses -->
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="File status" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Foreground="{StaticResource Ok}" Text="Present" /> — the file is still at that path.<LineBreak />
                                            <Run FontWeight="SemiBold" Foreground="{StaticResource High}" Text="Deleted" /> — the USN journal recorded its deletion (time shown).<LineBreak />
                                            <Run FontWeight="SemiBold" Foreground="{StaticResource High}" Text="Recycle Bin" /> — moved to the Recycle Bin (time shown).<LineBreak />
                                            <Run FontWeight="SemiBold" Foreground="{StaticResource High}" Text="Renamed" /> — renamed after it ran; the new name is in the details.<LineBreak />
                                            <Run FontWeight="SemiBold" Foreground="{StaticResource Medium}" Text="Missing" /> — gone, but no deletion record survives (the journal wraps, so this alone proves nothing).<LineBreak />
                                            <Run FontWeight="SemiBold" Foreground="{StaticResource Medium}" Text="Drive absent" /> — it ran from a drive that is not plugged in now, e.g. a USB stick.<LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="Executed" /> = started as a process.  <Run FontWeight="SemiBold" Text="Loaded" /> = loaded by another program (DLLs, jars).  <Run FontWeight="SemiBold" Text="Seen" /> = only referenced in a cache, log or memory.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Severity -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="What High, Medium and Low mean" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,12" Text="Findings are leads, not verdicts. Always open the evidence before deciding." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border CornerRadius="{StaticResource RadiusS}" Padding="8,2" Background="{StaticResource HighSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="High" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource High}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Sub}" Foreground="{StaticResource Text}" Margin="0,0,0,12" TextWrapping="Wrap"
                                                   Text="Does not happen on an untouched PC, or evidence was clearly destroyed: a run recorded after the file was deleted, timestamps in the future, the clock set back by hand, faked file dates, the USN journal deleted, event logs cleared, Prefetch or a key service disabled, recently used Prefetch files deleted in a batch." />
                                        <Border Grid.Row="1" CornerRadius="{StaticResource RadiusS}" Padding="8,2" Background="{StaticResource MediumSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="Medium" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Medium}" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Sub}" Foreground="{StaticResource Text}" Margin="0,0,0,12" TextWrapping="Wrap"
                                                   Text="A strong lead with possible innocent explanations: a cheat or tool name, ran then deleted within an hour, contents replaced after the last run, a disguised or renamed program, anti-forensic commands, DPS / PcaSvc restarted after boot." />
                                        <Border Grid.Row="2" CornerRadius="{StaticResource RadiusS}" Padding="8,2" Background="{StaticResource LowSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="Low" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Low}" />
                                        </Border>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Sub}" Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                                   Text="Context that is often normal: Windows housekeeping (Prefetch pruning, updates), app updates, deleted long after running, Defender detections, launch times that do not line up. Each one says why it is Low." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <!-- Sources -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Where the evidence comes from" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Text="Prefetch" /> — last 8 run times and run count of each program, and the DLLs and jars it loaded.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="BAM / PCA / UserAssist" /> — when programs ran, per user, and launches through Explorer; BAM entries deleted since are read back from the registry file.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Amcache / ShimCache" /> — programs Windows has inventoried, with SHA-1 and dates; survives Prefetch being cleared.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="USN journal / Recycle Bin" /> — file creations, deletions and renames; also reveals clock rollbacks.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Recent shortcuts / file dialogs / taskbar records" /> — files opened from Explorer, files picked in Open and Save dialogs, and programs used from the taskbar.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Crash reports" /> — programs that crashed (proof they ran) and the modules they had loaded.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Privacy access" /> — every desktop program that used the camera, microphone, location or screen capture, with the start and stop time of its last use, even after it was deleted.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Event logs / Memory" /> — clock changes, cleared logs, services, and program paths still held in memory.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Options -->
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Options and own traces" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Text="Scan memory" /> — off only if the scan must be quicker; memory catches programs nothing else recorded.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Check signatures and hashes" /> — needed for disguised or renamed programs and for VirusTotal lookups.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Hide private details" /> — reports mask PC and user names and drop personal history; files, findings and flagged commands stay.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Save the report automatically" /> — an HTML and a JSON report land in "Screenshare reports" on the Desktop.<LineBreak /><LineBreak />
                                            <Run FontWeight="SemiBold" Text="Filters" /> — a chip narrows the list to rows that are what it says, and carries how many rows that is. The "hidden" button lists what is kept out of the way on the page, each kind with its count and a switch to show it: routine files, copies of one library, this suite's own traces, rows with nothing flagged. A search looks through hidden rows too.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Search" /> — every word typed must be in the row, in any order. <Run Text="!word" FontFamily="{StaticResource MonoFont}" /> leaves out rows that have it, and quotes keep words together. In the findings, <Run Text="area:programs" FontFamily="{StaticResource MonoFont}" /> (or recording, logs, clock, antivirus, wiping, arguments, usb) lists one area, which is what an Overview row opens.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Period" /> — the scan reads and cross-checks everything; the period in the title bar only decides what is listed. A narrower one is cut from the scan already made; a wider one than was scanned scans again, so the older files are checked too. Findings about the PC as it is now stay in every period, and while a narrower period is shown the title bar counts the flagged findings dated before it.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="This suite's own traces" /> — running History Parser or the other programs in this suite (Program Checker, Client Parser, Malware Checker, Cheat String Finder) leaves traces: their runs, unpacked runtime, launcher. A copy only counts as this suite when it is byte-for-byte the same file as the one in the running program's folder, so a cheat renamed to one of these names still shows. They are never counted as findings.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <!-- Shortcuts -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Shortcuts &amp; tips" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Text="Click a file" /> — every record of it, its signature, hash, dates and findings on the right.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Click a column" /> — sort by it; click again to reverse. Files start sorted by Last run.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Ctrl+F" /> — search the current page.  <Run FontWeight="SemiBold" Text="Esc" /> — clear the search.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Ctrl+C" /> — copy the selected row's path or command.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="Right-click" /> — copy path / name / SHA-256, open the folder, look the hash up on VirusTotal.<LineBreak />
                                            <Run FontWeight="SemiBold" Text="CSV" /> — exports exactly what the current page shows.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Screenshare tips -->
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Screenshare tips" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                            • Scan before the player restarts, closes Minecraft or closes terminals — memory and open-console evidence disappears.<LineBreak />
                                            • A very recent restart, or Explorer / DPS restarted shortly before the scan, is worth asking about.<LineBreak />
                                            • Names are easy to change: judge by behaviour (deleted after running, swapped, clock changes), not just names.<LineBreak />
                                            • Use Program Checker on anything suspicious and Client Parser on the running game.<LineBreak />
                                            • Use "Customize rules" to add your own record-tampering commands, and "Save file…" to share your rules with other staff.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Privacy & limits -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Privacy, safety and limits" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" LineHeight="20" Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                        • Read-only: nothing on the PC is changed, deleted or installed, and no driver is loaded. The only file it writes is a report you save (or the automatic save, if switched on).<LineBreak />
                                        • Offline: the scan never connects to the internet; a VirusTotal lookup only opens your browser when you click it.<LineBreak />
                                        • Reports contain private details (PC and user names, command history) — use "Hide private details" for reports you share.<LineBreak />
                                        • Open source and not obfuscated: read the code with ILSpy and compare it with the published source.<LineBreak />
                                        • Not read: SRUM and the search index; folders opened (ShellBags) and looked-up domains — those are browsing history, not execution; CSRSS memory (Windows protects it). cmd.exe keeps no history file, so its commands only show while the window is open.<LineBreak />
                                        • Command-line switches: --rules file.txt (load rules and scan), --autoscan (scan with defaults), --open report.json, --no-elevate.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
